# QX Chain Node Dockerfile
# Runs blockchain node with native Rust worker/validator using signature-based authentication
# No registration required - workers and validators authenticate via cryptographic signatures

FROM --platform=linux/arm64 rust:1.86-bullseye as builder

WORKDIR /polkadot

# System deps for building Substrate/Polkadot-based nodes
RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    cmake \
    llvm \
    libclang-dev \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Add WASM target and rust-src for Substrate runtime compilation
RUN rustup target add wasm32-unknown-unknown && \
    rustup component add rust-src

# Copy all source code and build
COPY . .

# Silence substrate build script git warnings
RUN git init && \
    git config user.email "build@docker.local" && \
    git config user.name "Docker Build" && \
    git add . && \
    git commit -m "Initial commit"

# Fetch dependencies and build in debug mode with persistent caches (BuildKit)
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    cargo fetch
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target,target=/polkadot/target \
    CARGO_PROFILE_DEV_DEBUG=1 CARGO_PROFILE_DEV_SPLIT_DEBUGINFO=packed \
    cargo build -p qxchain --locked --bin qxchain -j 2 && \
    mkdir -p /polkadot/dist && \
    cp target/debug/qxchain /polkadot/dist/qxchain

FROM --platform=linux/arm64 debian:bullseye-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    procps \
    jq \
    libssl1.1 \
    && rm -rf /var/lib/apt/lists/*

# Copy blockchain binary (debug build)
COPY --from=builder /polkadot/dist/qxchain /usr/local/bin/qxchain

# Create user
RUN useradd -m -u 1001 -s /bin/bash qxuser
WORKDIR /home/qxuser

USER qxuser

# Create data and logs directories
RUN mkdir -p /home/qxuser/data /home/qxuser/logs

# Create startup script for new signature-based architecture
RUN cat > /home/qxuser/start_node.sh << 'EOF'
#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Configuration from environment
NODE_ROLE="${NODE_ROLE:-worker}"
CHAIN_MODE="${CHAIN_MODE:-dev}"
AI_ENDPOINT="${AI_ENDPOINT:-http://host.docker.internal:11434}"
AI_MODEL="${AI_MODEL:-gemma3:1b}"
BASE_PATH="${BASE_PATH:-/home/qxuser/data}"
RPC_PORT="${RPC_PORT:-9944}"
LOG_LEVEL="${LOG_LEVEL:-info}"

show_usage() {
    echo "QX Chain Node (Signature-Based Architecture)"
    echo ""
    echo "Environment Variables:"
    echo "  NODE_ROLE        # Node role: worker, validator, or full (default: worker)"
    echo "  CHAIN_MODE       # Chain mode: dev, local (default: dev)"
    echo "  AI_ENDPOINT      # AI endpoint URL (default: http://host.docker.internal:11434)"
    echo "  AI_MODEL         # AI model name (default: gemma3:1b)"
    echo "  BASE_PATH        # Data directory (default: /home/qxuser/data)"
    echo "  RPC_PORT         # RPC port (default: 9944)"
    echo "  LOG_LEVEL        # Log level: error, warn, info, debug, trace (default: info)"
    echo ""
    echo "Examples:"
    echo "  docker run -e NODE_ROLE=worker -e AI_ENDPOINT=http://ollama:11434 qxchain-node"
    echo "  docker run -e NODE_ROLE=validator -e LOG_LEVEL=debug qxchain-node"
    echo "  docker run -e NODE_ROLE=full qxchain-node"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --help)
            show_usage
            exit 0
            ;;
        *)
            echo -e "${RED}❌ Unknown option: $1${NC}"
            show_usage
            exit 1
            ;;
    esac
done

# Function to handle shutdown
cleanup() {
    echo -e "\n${YELLOW}🛑 Shutting down gracefully...${NC}"

    if [ ! -z "$NODE_PID" ] && kill -0 $NODE_PID 2>/dev/null; then
        echo -e "${YELLOW}🔄 Stopping node...${NC}"
        kill $NODE_PID
        wait $NODE_PID 2>/dev/null
    fi

    echo -e "${GREEN}✅ Shutdown complete${NC}"
    exit 0
}

# Set up signal handlers
trap cleanup SIGINT SIGTERM

# Main execution
echo -e "${BLUE}🚀 Starting QX Chain Node${NC}"
echo -e "${BLUE}════════════════════════════════════════════${NC}"
echo -e "${BLUE}📋 Node Role: $NODE_ROLE${NC}"
echo -e "${BLUE}📋 Chain Mode: $CHAIN_MODE${NC}"
echo -e "${BLUE}📋 AI Endpoint: $AI_ENDPOINT${NC}"
echo -e "${BLUE}📋 AI Model: $AI_MODEL${NC}"
echo -e "${BLUE}📋 Log Level: $LOG_LEVEL${NC}"
echo -e "${BLUE}📋 Base Path: $BASE_PATH${NC}"
echo -e "${YELLOW}💡 Architecture: Signature-based (no registration required)${NC}"
echo ""

# Build node command
NODE_CMD="/usr/local/bin/qxchain"

# Add chain mode
if [ "$CHAIN_MODE" = "dev" ]; then
    NODE_CMD="$NODE_CMD --dev"
fi

# Add node role
NODE_CMD="$NODE_CMD --node-role $NODE_ROLE"

# Add AI configuration for workers and full nodes
if [ "$NODE_ROLE" = "worker" ] || [ "$NODE_ROLE" = "full" ]; then
    NODE_CMD="$NODE_CMD --ai-endpoint $AI_ENDPOINT --ai-model $AI_MODEL"
fi

# Add common options
NODE_CMD="$NODE_CMD \
    --base-path $BASE_PATH \
    --rpc-external \
    --rpc-cors all \
    --unsafe-rpc-external \
    --rpc-port $RPC_PORT \
    --port 30333 \
    -l $LOG_LEVEL"

echo -e "${CYAN}🚀 Starting node...${NC}"
echo -e "${BLUE}Command: $NODE_CMD${NC}"
echo ""

# Start node
$NODE_CMD &
NODE_PID=$!

echo -e "${GREEN}✅ Node started (PID: $NODE_PID)${NC}"
echo ""
echo -e "${GREEN}🎉 QX Chain node is running!${NC}"
echo -e "${BLUE}📊 WebSocket RPC: ws://localhost:$RPC_PORT${NC}"
echo -e "${BLUE}📊 HTTP RPC: http://localhost:$RPC_PORT${NC}"
echo -e "${BLUE}📄 Data directory: $BASE_PATH${NC}"
echo -e "${BLUE}📄 Logs: stdout/stderr${NC}"
echo ""

# Role-specific information
case "$NODE_ROLE" in
    "worker")
        echo -e "${CYAN}🤖 Worker Mode:${NC}"
        echo -e "   • Listens for inference requests in queue"
        echo -e "   • Uses signature-based authentication (no registration)"
        echo -e "   • Processes requests automatically"
        echo -e "   • Submits results back to chain"
        ;;
    "validator")
        echo -e "${CYAN}🛡️ Validator Mode:${NC}"
        echo -e "   • Validates inference results"
        echo -e "   • Uses signature-based authentication (no registration)"
        echo -e "   • Challenges suspicious results"
        ;;
    "full")
        echo -e "${CYAN}⚡ Full Node Mode:${NC}"
        echo -e "   • Both worker and validator capabilities"
        echo -e "   • Processes inference requests"
        echo -e "   • Validates results"
        ;;
esac

echo ""
echo -e "${YELLOW}💡 Press Ctrl+C to stop gracefully${NC}"

# Wait for node process
wait $NODE_PID
EOF

RUN chmod +x /home/qxuser/start_node.sh

# Expose ports
EXPOSE 9944 30333

# Default environment variables
ENV NODE_ROLE=worker
ENV CHAIN_MODE=dev
ENV AI_ENDPOINT=http://host.docker.internal:11434
ENV AI_MODEL=gemma3:1b
ENV BASE_PATH=/home/qxuser/data
ENV RPC_PORT=9944
ENV LOG_LEVEL=info

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f -H "Content-Type: application/json" -d '{"id":1,"jsonrpc":"2.0","method":"system_health","params":[]}' http://localhost:${RPC_PORT} || exit 1

CMD ["/home/qxuser/start_node.sh"]
