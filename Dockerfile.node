# QX Chain Unified Node Dockerfile
# Can run as worker, validator, or both based on startup parameters

FROM --platform=linux/arm64 rust:1.82-bullseye as builder

WORKDIR /polkadot

# System deps for building Substrate/Polkadot-based nodes
RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    cmake \
    llvm \
    libclang-dev \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Add WASM target and rust-src for Substrate runtime compilation
RUN rustup target add wasm32-unknown-unknown && \
    rustup component add rust-src

# Copy all source code and build
COPY . .

# Silence substrate build script git warnings
RUN git init && \
    git config user.email "build@docker.local" && \
    git config user.name "Docker Build" && \
    git add . && \
    git commit -m "Initial commit"

# Fetch dependencies and build in debug mode with persistent caches (BuildKit)
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    cargo fetch
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target,target=/polkadot/target \
    CARGO_PROFILE_DEV_DEBUG=1 CARGO_PROFILE_DEV_SPLIT_DEBUGINFO=packed \
    cargo build -p qxchain --locked --bin qxchain -j 2 && \
    mkdir -p /polkadot/dist && \
    cp target/debug/qxchain /polkadot/dist/qxchain

FROM --platform=linux/arm64 ubuntu:22.04

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    python3 \
    python3-pip \
    lsof \
    procps \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Copy blockchain binary (debug build)
COPY --from=builder /polkadot/dist/qxchain /usr/local/bin/qxchain

# Create user
RUN useradd -m -u 1001 -s /bin/bash qxuser
WORKDIR /home/qxuser

# Install Python dependencies
COPY scripts/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

# Copy scripts
COPY scripts/ /home/qxuser/scripts/
RUN chown -R qxuser:qxuser /home/qxuser/scripts/

USER qxuser

# Create data and logs directories
RUN mkdir -p /home/qxuser/data /home/qxuser/logs

# Create unified startup script
RUN cat > /home/qxuser/start_node.sh << 'EOF'
#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
NC='\033[0m'

# Default configuration
NODE_TYPE="${NODE_TYPE:-worker}"
CHAIN_NAME="${CHAIN_NAME:-dev}"
ACCOUNT_SEED="${ACCOUNT_SEED:-//Bob}"
OLLAMA_ENDPOINT="${OLLAMA_ENDPOINT:-http://host.docker.internal:11434}"
# Workers always setup model automatically
INTERACTIVE="${INTERACTIVE:-false}"
AUTO_MODE="${AUTO_MODE:-true}"
BOOTNODES="${BOOTNODES:-}"

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --type)
            NODE_TYPE="$2"
            shift 2
            ;;
        --seed)
            ACCOUNT_SEED="$2" 
            shift 2
            ;;
        --chain)
            CHAIN_NAME="$2"
            shift 2
            ;;
        --ollama)
            OLLAMA_ENDPOINT="$2"
            shift 2
            ;;
        --bootnodes)
            BOOTNODES="$2"
            shift 2
            ;;
        --help)
            show_usage
            exit 0
            ;;
        *)
            echo -e "${RED}❌ Unknown option: $1${NC}"
            show_usage
            exit 1
            ;;
    esac
done

show_usage() {
    echo "QX Chain Unified Node"
    echo ""
    echo "Usage:"
    echo "  docker run [docker-opts] qxchain-node [options]"
    echo ""
    echo "Node Types:"
    echo "  --type worker              # Worker node only (default)"
    echo "  --type validator           # Validator node only"
    echo "  --type both                # Both worker and validator"
    echo ""
    echo "Common Options:"
    echo "  --seed SEED                # Account seed (default: //Bob)"
    echo "  --chain CHAIN              # Chain spec (default: dev)"
    echo "  --ollama URL               # Ollama endpoint (default: http://host.docker.internal:11434)"
    echo "  --bootnodes NODES          # Bootnode addresses"
    echo "Examples:"
    echo "  docker run -p 9944:9944 qxchain-node --type worker --seed //Bob"
    echo "  docker run -p 9944:9944 qxchain-node --type validator --seed //Charlie"
    echo "  docker run -p 9944:9944 qxchain-node --type both --seed //Alice"
}

# Function to wait for service
wait_for_service() {
    local url=$1
    local name=$2
    local max_attempts=30
    local attempt=0
    
    echo -e "${YELLOW}⏳ Waiting for $name to be ready...${NC}"
    
    while [ $attempt -lt $max_attempts ]; do
        if curl -s "$url" >/dev/null 2>&1; then
            echo -e "${GREEN}✅ $name is ready!${NC}"
            return 0
        fi
        
        attempt=$((attempt + 1))
        sleep 2
    done
    
    echo -e "${RED}❌ $name failed to start within timeout${NC}"
    return 1
}

# Function to check if blockchain is already running
check_blockchain_running() {
    curl -s http://host.docker.internal:9933 > /dev/null 2>&1
}

# Function to start blockchain node
start_blockchain_node() {
    # Always try to connect to ws://host.docker.internal:9933 first
    echo -e "${BLUE}🔗 Checking for existing blockchain at ws://host.docker.internal:9933...${NC}"
    
    if check_blockchain_running; then
        echo -e "${GREEN}✅ Found existing blockchain at ws://host.docker.internal:9933${NC}"
        echo -e "${BLUE}🔗 Connecting to existing blockchain (client-only mode)${NC}"
        return 0
    fi
    
    echo -e "${YELLOW}📋 No existing blockchain found, starting new blockchain node...${NC}"
    
    # Determine blockchain account based on node type and seed
    local blockchain_account=""
    case "$ACCOUNT_SEED" in
        "//Alice"|"//alice")
            blockchain_account="--alice"
            ;;
        "//Bob"|"//bob")
            blockchain_account="--bob"
            ;;
        "//Charlie"|"//charlie")
            blockchain_account="--charlie"
            ;;
        "//Dave"|"//dave")
            blockchain_account="--dave"
            ;;
        "//Eve"|"//eve")
            blockchain_account="--eve"
            ;;
        *)
            blockchain_account="--alice"  # Default fallback
            ;;
    esac
    
    # Base node command (using --dev for simpler setup)
    local node_cmd="/usr/local/bin/qxchain \
        --dev \
        $blockchain_account \
        --base-path /home/qxuser/data \
        --rpc-external \
        --unsafe-rpc-external \
        --port 30333 \
        --rpc-port 9933"
    
    echo -e "${BLUE}📋 Blockchain account: $blockchain_account${NC}"
    echo -e "${BLUE}📋 Node command: $node_cmd${NC}"
    
    # Start blockchain node in background
    $node_cmd > /home/qxuser/logs/blockchain.log 2>&1 &
    BLOCKCHAIN_PID=$!
    
    echo -e "${GREEN}✅ Blockchain node started (PID: $BLOCKCHAIN_PID)${NC}"
    
    # Wait for blockchain to be ready
    if ! wait_for_service "http://localhost:9933" "Blockchain"; then
        echo -e "${RED}❌ Failed to start blockchain node${NC}"
        return 1
    fi
    
    return 0
}

# Function to start worker
start_worker() {
    echo -e "${CYAN}🤖 Starting worker component...${NC}"
    
    local worker_cmd="python3 /home/qxuser/scripts/ollama_worker.py \
        --chain ws://host.docker.internal:9933 \
        --ollama $OLLAMA_ENDPOINT \
        --seed \"$ACCOUNT_SEED\" \
        --no-node"
    
    # Workers run in auto-mode by default (queue listener)
    
    echo -e "${BLUE}📋 Worker command: $worker_cmd${NC}"
    
    cd /home/qxuser/scripts
    eval $worker_cmd &
    WORKER_PID=$!
    
    echo -e "${GREEN}✅ Worker started (PID: $WORKER_PID)${NC}"
    return 0
}

# Function to start validator
start_validator() {
    echo -e "${PURPLE}🛡️ Starting validator component...${NC}"
    
    # Always use host.docker.internal:9933 to connect to existing blockchain
    local chain_endpoint="ws://host.docker.internal:9933"
    
    # Generate a unique peer ID for this validator
    local peer_id="validator_$(echo $ACCOUNT_SEED | tr -d '/' | tr '[:upper:]' '[:lower:]')_$(date +%s)"
    local node_endpoint="ws://host.docker.internal:9933"
    
    local validator_cmd="python3 /home/qxuser/scripts/validator.py \
        --chain $chain_endpoint \
        --ollama $OLLAMA_ENDPOINT \
        --seed \"$ACCOUNT_SEED\" \
        --no-node \
        --peer-id \"$peer_id\" \
        --node-endpoint \"$node_endpoint\""
    
    echo -e "${BLUE}📋 Validator command: $validator_cmd${NC}"
    
    cd /home/qxuser/scripts
    
    # For validator-only mode, run in foreground for interactive access
    if [ "$NODE_TYPE" = "validator" ]; then
        echo -e "${YELLOW}💡 Validator-only mode: Running in foreground for interactive access${NC}"
        echo -e "${YELLOW}💡 Use Ctrl+C to stop gracefully${NC}"
        eval $validator_cmd
    else
        # For "both" mode, run in background
        echo -e "${YELLOW}💡 Combined mode: Starting validator in background${NC}"
        eval $validator_cmd &
        VALIDATOR_PID=$!
        echo -e "${GREEN}✅ Validator started (PID: $VALIDATOR_PID)${NC}"
    fi
    
    return 0
}

# Function to handle shutdown
cleanup() {
    echo -e "\n${YELLOW}🛑 Shutting down gracefully...${NC}"
    
    if [ ! -z "$WORKER_PID" ] && kill -0 $WORKER_PID 2>/dev/null; then
        echo -e "${YELLOW}🔄 Stopping worker...${NC}"
        kill $WORKER_PID
    fi
    
    if [ ! -z "$VALIDATOR_PID" ] && kill -0 $VALIDATOR_PID 2>/dev/null; then
        echo -e "${YELLOW}🔄 Stopping validator...${NC}"
        kill $VALIDATOR_PID
    fi
    
    if [ ! -z "$BLOCKCHAIN_PID" ] && kill -0 $BLOCKCHAIN_PID 2>/dev/null; then
        echo -e "${YELLOW}🔄 Stopping blockchain...${NC}"
        kill $BLOCKCHAIN_PID
    fi
    
    echo -e "${GREEN}✅ Shutdown complete${NC}"
    exit 0
}

# Set up signal handlers
trap cleanup SIGINT SIGTERM

# Main execution
echo -e "${BLUE}🚀 Starting QX Chain Unified Node${NC}"
echo -e "${BLUE}═══════════════════════════════════${NC}"
echo -e "${BLUE}📋 Node Type: $NODE_TYPE${NC}"
echo -e "${BLUE}📋 Account: $ACCOUNT_SEED${NC}"
echo -e "${BLUE}📋 Chain: $CHAIN_NAME${NC}"
echo -e "${BLUE}📋 Ollama: $OLLAMA_ENDPOINT${NC}"
echo -e "${BLUE}📋 Worker Mode: Automatic Queue Listener${NC}"
if [ "$NODE_TYPE" = "validator" ] || [ "$NODE_TYPE" = "both" ]; then
    echo -e "${BLUE}📋 Validation Mode: Interactive${NC}"
fi
echo ""

# Start blockchain node first
if ! start_blockchain_node; then
    echo -e "${RED}❌ Failed to start blockchain node. Exiting.${NC}"
    exit 1
fi

# Wait a moment for blockchain to stabilize
sleep 5

# Start components based on node type
case "$NODE_TYPE" in
    "worker")
        start_worker
        echo -e "${GREEN}✅ Worker node ready!${NC}"
        ;;
    "validator")
        start_validator
        echo -e "${GREEN}✅ Validator node ready!${NC}"
        ;;
    "both")
        start_worker
        sleep 2
        start_validator
        echo -e "${GREEN}✅ Combined worker/validator node ready!${NC}"
        ;;
    *)
        echo -e "${RED}❌ Unknown node type: $NODE_TYPE${NC}"
        show_usage
        exit 1
        ;;
esac

# Only show final messages for non-validator modes
if [ "$NODE_TYPE" != "validator" ]; then
    echo ""
    echo -e "${GREEN}🎉 QX Chain node is running!${NC}"
    echo -e "${BLUE}📊 Blockchain WebSocket: ws://localhost:9944${NC}"
    echo -e "${BLUE}📊 Blockchain HTTP RPC: http://localhost:9933${NC}"
    echo -e "${BLUE}📄 Logs directory: /home/qxuser/logs/${NC}"
    echo -e "${YELLOW}💡 Press Ctrl+C to stop gracefully${NC}"

    # Keep the script running and wait for signals
    while true; do
        sleep 1
    done
fi
EOF

RUN chmod +x /home/qxuser/start_node.sh

# Expose blockchain ports
EXPOSE 9944 9933 30333

# Default environment variables
ENV NODE_TYPE=worker
ENV CHAIN_NAME=dev
ENV ACCOUNT_SEED=//Bob
ENV OLLAMA_ENDPOINT=http://host.docker.internal:11434
ENV BOOTNODES=""

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:9933/health || exit 1

CMD ["/home/qxuser/start_node.sh"]
