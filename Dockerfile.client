# QX Chain Client Dockerfile
# Runs a Python client for interacting with QX Chain workers

FROM ubuntu:22.04

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Create user
RUN useradd -m -u 1001 -s /bin/bash qxuser
WORKDIR /home/qxuser

# Install Python dependencies
COPY scripts/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

# Copy scripts
COPY scripts/ /home/qxuser/scripts/
RUN chown -R qxuser:qxuser /home/qxuser/scripts/

USER qxuser

# Create logs directory
RUN mkdir -p /home/qxuser/logs

# Create startup script
RUN cat > /home/qxuser/start_client.sh << 'EOF'
#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${BLUE}🚀 Starting QX Chain Client...${NC}"

# Configuration with defaults
CHAIN_ENDPOINT="${CHAIN_ENDPOINT:-ws://host.docker.internal:9944}"
CUSTOMER_SEED="${CUSTOMER_SEED:-//Alice}"
INTERACTIVE="${INTERACTIVE:-true}"

echo -e "${BLUE}🔧 Client Configuration:${NC}"
echo -e "   Chain endpoint: ${CHAIN_ENDPOINT}"
echo -e "   Customer seed: ${CUSTOMER_SEED}"
echo -e "   Interactive mode: ${INTERACTIVE}"

# Build client command (customer.py is always interactive)
CLIENT_CMD="python3 /home/qxuser/scripts/customer.py --chain $CHAIN_ENDPOINT --seed $CUSTOMER_SEED"

echo -e "${BLUE}👤 Starting customer client...${NC}"
echo -e "${YELLOW}Command: ${CLIENT_CMD}${NC}"

cd /home/qxuser/scripts
exec $CLIENT_CMD
EOF

RUN chmod +x /home/qxuser/start_client.sh

# Environment variables
ENV CHAIN_ENDPOINT=ws://localhost:9933
ENV CUSTOMER_SEED=//Alice
ENV INTERACTIVE=true

# No exposed ports needed for client
# Health check based on script availability
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python3 /home/qxuser/scripts/customer.py --help > /dev/null || exit 1

CMD ["/home/qxuser/start_client.sh"]
