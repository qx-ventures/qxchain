# Docker Platform Configuration
# Set the target platform for building the QXChain Docker image
#
# For Intel/AMD processors (x86_64):
DOCKER_DEFAULT_PLATFORM=linux/amd64
#
# For ARM processors (Apple Silicon, Raspberry Pi, etc):
# DOCKER_DEFAULT_PLATFORM=linux/arm64
#
# For macOS (Note: requires Docker Desktop with buildx):
# DOCKER_DEFAULT_PLATFORM=darwin/amd64  # Intel Mac
# DOCKER_DEFAULT_PLATFORM=darwin/arm64  # Apple Silicon Mac

# QXChain Configuration
RUST_LOG=info